# Variables read by this app. No secrets belong here or in the repo.

# Base URL of Aplication_server; the browser never calls it directly.
# Default when unset: http://127.0.0.1:3110
APLICATION_SERVER_URL=http://127.0.0.1:3110

# Port of the fake Aplication_server used by e2e only (tests/e2e/lazni-server.mjs).
# Default when unset: 3199
LAZNI_PORT=3199

# Set by Next.js itself (dev/build/start), not by hand. In production the session
# cookie is deleted with Secure, matching how it is set.
# NODE_ENV=production
